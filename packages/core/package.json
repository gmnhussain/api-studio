{
  "name": "@api-studio/core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free API Studio engine: models, variables, HTTP utilities, code generation, import and export.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage"
  },
  "devDependencies": {
    "@api-studio/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
