{
  "name": "api-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:watch": "turbo watch test:unit",
    "test:coverage": "turbo run test:coverage",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs && depcruise apps/web --config apps/web/.dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@api-studio/config": "workspace:*",
    "dependency-cruiser": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24 <25"
  }
}
