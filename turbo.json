{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["NEXT_RUNTIME"],
  "tasks": {
    "typegen": {
      "outputs": [".next/types/**", ".next/dev/types/**", "next-env.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "typegen", "lint", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_*", "PROXY_*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^typecheck", "typegen"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "typegen"]
    },
    "test:unit": {
      "outputs": []
    },
    "test:integration": {
      "outputs": [],
      "cache": false
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_ALL_BROWSERS"]
    }
  }
}
